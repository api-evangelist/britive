{
  "opencollection": "1.0.0",
  "info": {
    "name": "Britive Services API Documentation User Identity Attributes API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
