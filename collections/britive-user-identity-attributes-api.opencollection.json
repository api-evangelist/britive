              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get details of a specified identity attribute"
        },
        {
          "info": {
            "name": "Update specified identity attribute details",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenantURL}/api/users/attributes/:id",
            "params": [
