            "url": "https://{tenantURL}/api/users/attributes/data-types"
          },
          "docs": "Get data types of identity attribute"
        },
        {
          "info": {
            "name": "Get details of a specified identity attribute",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/users/attributes/:id",
            "params": [
              {
                "name": "userAttribute",
                "value": "",
