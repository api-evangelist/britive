            "method": "GET",
            "url": "https://{tenantURL}/api/access/users/attributes"
          },
          "docs": "Returns all user identity attributes defined in the system. This access-scoped endpoint mirrors `GET /api/users/attributes` but is accessible via the access API path.\n"
        },
        {
          "info": {
            "name": "Get a list of all identity attributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/user-attributes"
          },
          "docs": "Get a list of all identity attributes"
        },
        {
          "info": {
            "name": "Get list of all custom attributes in the system",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/users/attributes",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get list of all custom attributes in the system"
        },
        {
          "info": {
            "name": "Create an identity attribute in the system",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/users/attributes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an identity attribute in the system"
        },
        {
          "info": {
            "name": "Get data types of identity attribute",
