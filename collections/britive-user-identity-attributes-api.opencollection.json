            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update specified identity attribute details"
        },
        {
          "info": {
            "name": "Delete a specified identity attribute",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/users/attributes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
