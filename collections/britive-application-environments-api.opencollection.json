{
  "opencollection": "1.0.0",
  "info": {
    "name": "Britive Services API Documentation Application Environments API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Application Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get details of all environments present in the system",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environments",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get details of all environments present in the system"
        },
        {
          "info": {
            "name": "Get an environment within an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environments/:environmentId",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an environment within an application"
        },
        {
          "info": {
            "name": "Delete an environment within an application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environments/:environmentId",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This applies to the following applications - AWS Standalone, SalesForce, and ServiceNow."
        },
        {
          "info": {
            "name": "Get accounts associated with a group for a given application and environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environments/:environmentId/groups/:groupId/accounts",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Parameter to specify the page number of the records to retrieve"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "parameter to specify the number of records to retrieve per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "parameter to specify the sort parameter and direction"
              }
            ]
          },
          "docs": "Get accounts associated with a group for a given application and environment"
        },
        {
          "info": {
            "name": "Submit a scan for the application and environment IDs provided in the request and returns the taskID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environments/:environmentId/scans",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "You can use the Check Scan Status API to find the status of the scan task."
        },
        {
          "info": {
            "name": "Submits a scan for specified application and environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environments/:environmentId/scans",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "You can use the Check Scan Status API to find the status of the scan task."
        }
      ]
    }
  ],
  "bundled": true
}