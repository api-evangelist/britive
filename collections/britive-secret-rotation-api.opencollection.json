{
  "opencollection": "1.0.0",
  "info": {
    "name": "Secret Manager Secret Rotation API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secret Rotation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Secret Rotation History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/v1/secretmanager/vault/:vaultId/secrets/:secretId/rotate/history",
            "params": [
              {
                "name": "vaultId",
                "value": "a6ed82f6-32b5-46d8-a3a3-c36cc574abd9",
                "type": "path",
                "description": "Vault identifier"
              },
              {
                "name": "secretId",
                "value": "secret-123",
                "type": "path",
                "description": "Secret identifier"
              },
              {
                "name": "size",
                "value": "10",
                "type": "query",
                "description": "Page size for pagination"
              },
              {
                "name": "lastKey",
                "value": "",
                "type": "query",
                "description": "Last evaluated key for pagination"
              }
            ]
          },
          "docs": "Lists all rotation history for a secret, ordered by date (newest first)."
        },
        {
          "info": {
            "name": "Get Secret Rotation History for Time ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/v1/secretmanager/vault/:vaultId/secrets/:secretId/rotate/history/:timeId",
            "params": [
              {
                "name": "vaultId",
                "value": "a6ed82f6-32b5-46d8-a3a3-c36cc574abd9",
                "type": "path",
                "description": "Vault identifier"
              },
              {
                "name": "secretId",
                "value": "secret-123",
                "type": "path",
                "description": "Secret identifier"
              },
              {
                "name": "timeId",
                "value": "1",
                "type": "path",
                "description": "Time ID of the rotation history entry"
              }
            ]
          },
          "docs": "Returns rotation history for a specific Time ID."
        }
      ]
    }
  ],
  "bundled": true
}