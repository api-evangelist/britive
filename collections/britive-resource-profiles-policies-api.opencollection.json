            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to get policies"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Parameter to filter policy by name"
              }
            ]
          },
          "docs": "Get all policies associated to a profile"
        },
        {
          "info": {
            "name": "Add policy to profile to grant resources to end user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/policies",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of the profile to add policy"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add policy to profile to grant resources to end user"
        },
        {
          "info": {
            "name": "Set orders for policies associated with an entity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/policies/order",
            "params": [
