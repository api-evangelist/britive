                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "ID of the profile"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set orders for policies associated with an entity"
        },
        {
          "info": {
            "name": "Get policy details for a given policy id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/policies/:policyId",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to add policy"
              },
              {
                "name": "policyId",
                "value": "",
                "type": "path",
                "description": "policy Id to fetch policy details"
              },
              {
                "name": "compactResponse",
                "value": "",
                "type": "query",
                "description": "Policy details in compact json foramt"
              }
            ]
          },
          "docs": "Get policy details for a given policy id"
        },
        {
          "info": {
            "name": "Update policy details for a given policy id",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/policies/:policyId",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to add policy"
              },
              {
                "name": "policyId",
                "value": "",
                "type": "path",
                "description": "policy ID to update policy details"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
