{
  "opencollection": "1.0.0",
  "info": {
    "name": "Britive Services API Documentation Resource Profiles - Policies API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
