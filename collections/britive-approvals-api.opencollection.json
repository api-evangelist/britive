{
  "opencollection": "1.0.0",
  "info": {
    "name": "Secret Manager Approvals API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Approvals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the list of all approval requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/v1/approvals/",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query"
              },
              {
                "name": "requestType",
                "value": "",
                "type": "query",
                "description": "Specifies the type of request"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Autogenerated token for next page of records in case the results are more than one page. Append this token in requested API URL to access the next set of pages."
              },
              {
                "name": "consumer",
                "value": "",
                "type": "query"
              },
              {
                "name": "activeStatus",
                "value": "",
                "type": "query"
              },
              {
                "name": "createdWithinDays",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get the list of all approval requests"
        },
        {
          "info": {
            "name": "Revoke bulk requests",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/v1/approvals/revoke",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Revoke bulk requests"
        },
        {
          "info": {
            "name": "Get approval request details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/v1/approvals/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "requestType",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get approval request details"
        },
        {
          "info": {
            "name": "Approve/Reject/Revoke a specified request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenantURL}/api/v1/approvals/:id",
            "params": [
              {
                "name": "approveRequest",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "killSession",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Approve/Reject/Revoke a specified request"
        },
        {
          "info": {
            "name": "Cancel approval request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/v1/approvals/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel approval request"
        }
      ]
    }
  ],
  "bundled": true
}