          "info": {
            "name": "Delete broker poold for a resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/resource-manager/resources/:id/broker-pools/:brokerPoolId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource mapped to broker pools"
              },
              {
                "name": "brokerPoolId",
                "value": "",
                "type": "path",
                "description": "brokerPoolId to be deleted."
