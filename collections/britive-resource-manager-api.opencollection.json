          "info": {
            "name": "Manage resource broker pools",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/resource-manager/resources/:id/broker-pools",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource mapped to broker pools"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
