{
  "opencollection": "1.0.0",
  "info": {
    "name": "Britive Services API Documentation Applications API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get details of all applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps"
          },
          "docs": "Get details of all applications"
        },
        {
          "info": {
            "name": "Create a new application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/apps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new application"
        },
        {
          "info": {
            "name": "Check the status of currently active scans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/tasks/:taskId/status",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Check the status of currently active scans"
        },
        {
          "info": {
            "name": "Delete an environment group within an application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/apps/:appContainerId/environment-groups/:envGroupId",
            "params": [
              {
                "name": "appContainerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "envGroupId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Applies to the following applications, AWS Standalone, SalesForce, and ServiceNow"
        },
        {
          "info": {
            "name": "Get details of a specific application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ]
          },
          "docs": "Get details of a specific application"
        },
        {
          "info": {
            "name": "Enable or disable a specific Application",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{tenantURL}/api/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enable or disable a specific Application"
        },
        {
          "info": {
            "name": "Update application properties",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenantURL}/api/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update application properties"
        },
        {
          "info": {
            "name": "Delete a specific application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ]
          },
          "docs": "Delete a specific application"
        }
      ]
    }
  ],
  "bundled": true
}