        {
          "id": "0c731c2f-7f3f-4175-9f17-3065db254f79",
          "name": "Get a list of active sessions for a specific user",
          "request": {
            "name": "Get a list of active sessions for a specific user",
            "description": {
              "content": "Returns the active sessions (sessions in any state other than checked in or checkout failed) of the specified user. Supported filter attributes are `profileName`, `appName`, `environmentName`, `environmentId`, `accessType` (values `CONSOLE`, `PROGRAMMATIC`) and `appType`; the `in` operator is supported for `appName` and `appType` only. If `searchText` is provided, it takes precedence over `filter` and is applied as `profileName co <searchText>`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "paps",
                "sessions",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "searchText",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Parameter to specify the page number of the records to retrieve"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "20",
                  "description": "parameter to specify the number of records to retrieve per page"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "parameter to specify the sort parameter and direction"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the user whose active sessions are returned"
                },
                {
                  "description": "The host of the server",
                  "type": "any",
                  "value": "{{tenantURL}}",
                  "key": "tenantURL"
                }
              ]
            },
