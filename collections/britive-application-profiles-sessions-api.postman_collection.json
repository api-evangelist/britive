        {
          "id": "b0b5935e-9894-44c2-a156-72f05c3d717b",
          "name": "Check in an active session by transaction ID",
          "request": {
            "name": "Check in an active session by transaction ID",
            "description": {
              "content": "Checks in the application profile session identified by the given transaction ID. The operation is idempotent - checking in an already checked-in session succeeds without effect. Sessions with access type `DEVICE` cannot be checked in through this API. An audit event of type ADMIN_ACCESS_CHECKIN is generated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "paps",
                "sessions",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
