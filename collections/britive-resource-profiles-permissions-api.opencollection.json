{
  "opencollection": "1.0.0",
  "info": {
    "name": "Britive Services API Documentation Resource Profiles - Permissions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resource Profiles - Permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of available system defined values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/resource-manager/profiles/permissions/system-defined-values",
            "params": [
              {
                "name": "resourceTypeId",
                "value": "",
                "type": "query",
                "description": "resource type id"
              }
            ]
          },
          "docs": "Get list of available system defined values"
        },
        {
          "info": {
            "name": "List permissions available to a profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/available-permissions",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to add permission"
              },
              {
                "name": "searchText",
                "value": "",
                "type": "query",
                "description": "Parameter to filter permission by search text"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Parameter to specify the page number of the records to retrieve"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Parameter to specify the number of records to retrieve per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "parameter to specify the sort parameter and direction"
              }
            ]
          },
          "docs": "List permissions available to a profile"
        },
        {
          "info": {
            "name": "List permissions associated to a profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/permissions",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to add permission"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Parameter to filter permissions by name"
              },
              {
                "name": "searchText",
                "value": "",
                "type": "query",
                "description": "Parameter to filter permission by search text"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Parameter to specify the page number of the records to retrieve"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Parameter to specify the number of records to retrieve per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "parameter to specify the sort parameter and direction"
              }
            ]
          },
          "docs": "List permissions associated to a profile"
        },
        {
          "info": {
            "name": "Add permission to resource profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/permissions",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to add permission"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add permission to resource profile"
        },
        {
          "info": {
            "name": "Update permission variable values",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/permissions/:permissionId",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "profile id  to which permission got associated"
              },
              {
                "name": "permissionId",
                "value": "",
                "type": "path",
                "description": "permission id to update details"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update permission variable values"
        },
        {
          "info": {
            "name": "Delete permission from resource profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantURL}/api/resource-manager/profiles/:profileId/permissions/:permissionId",
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path",
                "description": "Id of profile to remove permission"
              },
              {
                "name": "permissionId",
                "value": "",
                "type": "path",
                "description": "Id of permission to remove from profile"
              }
            ]
          },
          "docs": "Delete permission from resource profile"
        }
      ]
    }
  ],
  "bundled": true
}